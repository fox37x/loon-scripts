#!name=网易大神每日领券
#!desc=打开小程序自动抓Cookie, 每天23:59启动(00:00/00:01两道备份), 00:00和00:01两轮准点抢券并推送Telegram
#!author=you

[Script]
http-request ^https:\/\/inf\.ds\.163\.com\/v1\/web\/ script-path=https://raw.githubusercontent.com/fox37x/loon-scripts/main/ds163.js, requires-body=false, timeout=40, tag=网易大神抓Cookie
cron "59 23 * * *" script-path=https://raw.githubusercontent.com/fox37x/loon-scripts/main/ds163.js, timeout=240, tag=网易大神领券
cron "0 0 * * *" script-path=https://raw.githubusercontent.com/fox37x/loon-scripts/main/ds163.js, timeout=150, argument=backup, tag=网易大神领券-备份1
cron "1 0 * * *" script-path=https://raw.githubusercontent.com/fox37x/loon-scripts/main/ds163.js, timeout=90, argument=backup, tag=网易大神领券-备份2

[MITM]
hostname = inf.ds.163.com
